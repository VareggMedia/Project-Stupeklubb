# Supabase
NEXT_PUBLIC_SUPABASE_URL= <du finner URl inne dere du EDIT TABLE i bunnen>
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= <du finner Publishable Key når du søker etter API KEYS i søkefelte>
SUPABASE_SECRET_KEY= <du finner Secret Key når du søker etter API KEYS i søkefelte>
# Resend
RESEND_API_KEY= <finner den under API Keys og trykker på Create API key>
# Limit Rate
RATE_LIMIT_HASH_SECRET= < skriv i terminalen `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` og lim inn nøkkelen her>
# Sanity (nyheter) – prototype-prosjektet, ikke hemmelig
NEXT_PUBLIC_SANITY_PROJECT_ID=nog2j6ck
NEXT_PUBLIC_SANITY_DATASET=production
